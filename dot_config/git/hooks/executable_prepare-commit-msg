#!/bin/sh
#
# Global git hook: prepare-commit-msg
# Automatically adds task ID prefix to commit messages in projects
#

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# Skip merge commits
[ "$COMMIT_SOURCE" = "merge" ] && exit 0

# Function to check if current repo is a project
is_project() {
    # Get repository root path
    repo_path=$(git rev-parse --show-toplevel 2>/dev/null)
    [ -z "$repo_path" ] && return 1
    
    # Get project directories from git config
    proj_dirs=$(git config --global --path --get hooks.projectsDirs 2>/dev/null)
    
    # If no project directories configured, treat all projects as non-project
    [ -z "$proj_dirs" ] && return 1
    
    # Check if repo path starts with any project directory
    IFS=':'
    for proj_dir in $proj_dirs; do
        case "$repo_path" in
            "$proj_dir"*)
                return 0
                ;;
        esac
    done
    return 1
}

# Only process projects
is_project || exit 0

# Get current branch and extract task ID
branch=$(git branch --show-current 2>/dev/null)
[ -z "$branch" ] && exit 0

task_id=$(echo "$branch" | grep -oE '[A-Z]+-[0-9]+' | head -1)
[ -z "$task_id" ] && exit 0

# Read current commit message
msg=$(cat "$COMMIT_MSG_FILE")

# Skip special commits
echo "$msg" | grep -qE "^(Merge|Revert|Initial commit)" && exit 0

# Add prefix if not already present
if ! echo "$msg" | grep -qE "^$task_id:"; then
    echo "$task_id: $msg" > "$COMMIT_MSG_FILE"
fi